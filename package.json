{
  "name": "dsh-music-companion",
  "version": "0.1.1",
  "description": "陪听：盯着 Windows 的系统媒体会话（QQ音乐/网易云/Spotify 挂后台都行），一换歌就往 DSH 的会话里推一句“话头”，让她讲讲自己的感受，同时记一份听歌流水和口味画像。",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "author": "huajiang114514",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huajiang114514/dsh-music-companion.git"
  },
  "homepage": "https://github.com/huajiang114514/dsh-music-companion#readme",
  "bugs": {
    "url": "https://github.com/huajiang114514/dsh-music-companion/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "music",
    "companion",
    "now-playing"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "os": [
    "win32"
  ]
}
